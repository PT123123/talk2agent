# Build artifacts
build/
**/build/

# Model files (large binaries, download separately)
models/
**/models/*.onnx
**/models/*.gguf

# Logs
*.log

# IDE / editor
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Config secrets
configs/*.local.yaml

# 运行时产物：崩溃转储 / 诊断文件会带本机绝对路径与用户名（C:\Users\<name>\...），
# 属于信息泄露，绝不入库
*crash_stack*.txt
*_diag_*.txt
*_stdout.txt
*_stderr.txt

# AI 工具的本地工作区（记忆/会话等），与项目代码无关
.workbuddy/
.trae-html-share-packages/

# 记忆数据库（运行时生成）
data/
**/data/*.db

# Large downloaded binaries / driver packages (not part of source)
*.exe
*.obj
*.png
driver9030/
_apply_driver.ps1
_stdout.txt
_stderr.txt
voice-agent/build-msvc/
voice-agent/data/

# Downloaded model packages & build dirs (regenerated by scripts, don't commit)
**/downloads/
**/sherpa-onnx-*-build/
**/sherpa-onnx-dml/
# sherpa-onnx FetchContent 源码（CMake 自动获取，勿提交为 gitlink）
**/sherpa-onnx-src/

# 编译产物/三方二进制（DLL/LIB/PDB 等超大文件，勿提交；构建时由 CMake 获取）
**/*.pdb
**/*.dll
**/*.lib
**/*.obj
**/*.exe
**/*.o
**/*.a